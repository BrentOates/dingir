# Required: bot token and application (client) ID from the Discord developer portal
TOKEN=
CLIENT_ID=

# Cron schedule (5 or 6 fields) for cleanup, birthday notifications and calendars
JOB_SCHEDULE=0 9 * * *

# IANA time zone used for scheduling and birthday calculations
BOT_TIMEZONE=Europe/London

# SQLite database file (directory is created if missing); use :memory: for throwaway runs
DB_PATH=data/dingir.sqlite

# Data for unreachable guilds is only purged after at least this many failed checks...
PURGE_MIN_FAILURES=3
# ...spanning at least this many days
PURGE_GRACE_DAYS=7

# Optional: register slash commands to this guild only (instant updates during development)
# DEV_GUILD_ID=
