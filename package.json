{
	"name": "dingir",
	"author": "Brent Oates",
	"repository": {
		"type": "git",
		"url": "https://github.com/BrentOates/dingir.git"
	},
	"version": "2.5.8",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"postbuild": "copyfiles -u 1 -e \"**/*.ts\" \"src/**/*\" dist/src/",
		"lint": "eslint .",
		"dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"npm run copy-and-start\"",
		"copy-and-start": "npm run postbuild && npm start",
		"start": "node dist/src/index.js"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.0.2",
		"discord.js": "^14.26.5",
		"dotenv": "^17.4.2",
		"glob": "^13.0.6",
		"luxon": "^3.7.2",
		"node-schedule": "^2.1.1",
		"reflect-metadata": "^0.2.2",
		"sequelize": "^6.37.8",
		"sequelize-typescript": "^2.1.6",
		"sqlite3": "^6.0.1",
		"tslib": "^2.8.1",
		"underscore": "^1.13.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/luxon": "^3.7.2",
		"@types/node": "^26.1.1",
		"@types/node-schedule": "^2.1.8",
		"@types/underscore": "^1.13.0",
		"@types/validator": "^13.15.10",
		"copyfiles": "^2.4.1",
		"eslint": "^10.7.0",
		"rimraf": "^6.1.3",
		"tsc-watch": "^7.2.1",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.63.0"
	},
	"overrides": {
		"brace-expansion@<=1.1.12": "1.1.16",
		"dottie@<=2.0.6": "2.0.7",
		"lodash@<=4.17.23": "4.18.1",
		"minimatch@<=3.1.3": "3.1.5",
		"undici@<=6.26.0": "6.27.0",
		"uuid@<11.1.1": "11.1.1",
		"validator@<=13.15.20": "13.15.35"
	}
}
