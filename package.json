{
	"name": "dingir",
	"author": "Brent Oates",
	"repository": {
		"type": "git",
		"url": "https://github.com/BrentOates/dingir.git"
	},
	"version": "3.0.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc",
		"postbuild": "copyfiles -u 1 -e \"**/*.ts\" \"src/**/*\" dist/src/",
		"lint": "eslint .",
		"test": "tsc -p tsconfig.test.json && node --test \"dist/tests/**/*.test.js\"",
		"dev": "tsc-watch --noClear -p ./tsconfig.json --onSuccess \"npm run copy-and-start\"",
		"copy-and-start": "npm run postbuild && npm start",
		"start": "node dist/src/index.js"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.0.2",
		"better-sqlite3": "^13.0.3",
		"discord.js": "^14.26.5",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.3",
		"luxon": "^3.7.2",
		"node-schedule": "^2.1.1",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/luxon": "^3.7.2",
		"@types/node": "^24.13.3",
		"@types/node-schedule": "^2.1.8",
		"copyfiles": "^2.4.1",
		"eslint": "^10.6.0",
		"rimraf": "^6.1.3",
		"tsc-watch": "^7.2.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0"
	},
	"overrides": {
		"brace-expansion@<=1.1.12": "1.1.17",
		"lodash@<=4.17.23": "4.18.1",
		"minimatch@<=3.1.3": "3.1.5",
		"undici@<=6.26.0": "6.27.0"
	}
}
