{
	"name": "dingir",
	"author": "Brent Oates",
	"repository": {
		"type": "git",
		"url": "https://github.com/BrentOates/dingir.git"
	},
	"version": "3.0.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"lint": "eslint .",
		"test": "node --test \"tests/**/*.test.ts\"",
		"dev": "node --watch --env-file-if-exists=.env src/index.ts",
		"start": "node --env-file-if-exists=.env src/index.ts",
		"deploy:commands": "node --env-file-if-exists=.env src/scripts/deploy-commands.ts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@napi-rs/canvas": "^1.0.2",
		"better-sqlite3": "^13.0.3",
		"croner": "^10.0.1",
		"discord.js": "^14.26.5",
		"drizzle-orm": "^0.45.3",
		"luxon": "^3.7.2"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/luxon": "^3.7.2",
		"@types/node": "^24.13.3",
		"eslint": "^10.6.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.63.0"
	},
	"overrides": {
		"brace-expansion@<=1.1.12": "1.1.17",
		"lodash@<=4.17.23": "4.18.1",
		"minimatch@<=3.1.3": "3.1.5",
		"undici@<=6.26.0": "6.27.0"
	},
	"type": "module"
}
