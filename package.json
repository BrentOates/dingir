{
  "name": "dingir",
  "version": "3.0.0",
  "author": "Brent Oates",
  "repository": {
    "type": "git",
    "url": "https://github.com/BrentOates/dingir.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 --test-coverage-include='src/**' --test-coverage-exclude='src/index.ts' --test-coverage-exclude='src/scripts/**' \"tests/**/*.test.ts\"",
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "dev:pretty": "node --watch --env-file-if-exists=.env src/index.ts | pino-pretty",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "deploy:commands": "node --env-file-if-exists=.env src/scripts/deploy-commands.ts",
    "typecheck": "tsc --noEmit",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.3",
    "luxon": "^3.7.2",
    "pino": "^10.4.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.4",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2003",
    "pino-pretty": "^13.2.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "lodash@<=4.17.23": "4.18.1",
    "undici@<=6.28.0": "6.29.0"
  },
  "engines": {
    "node": ">=24"
  }
}
