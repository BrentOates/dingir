{
	"compilerOptions": {
		"lib": ["ESNext"],
		"types": ["node"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"target": "ES2024",
		"noEmit": true,
		"strict": false,
		"strictNullChecks": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"skipLibCheck": true
	},
	"include": ["src", "tests"]
}
